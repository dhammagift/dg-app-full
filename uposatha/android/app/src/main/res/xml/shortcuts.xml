<?xml version="1.0" encoding="utf-8"?>
<!-- Static App Shortcuts (long-press the launcher icon): ONE, declared here. The launcher's menu
     holds FOUR entries and counts every declared shortcut against them, so the other three are
     dynamic — the next three Uposatha days, pushed by src/uposatha-bridge.js (DgShortcutsPlugin).

       Calendar -> the calendar tab of this app (the bridge opens the tab named in the route's ?tab=)

     It starts MainActivity with a "route" extra, which MainActivity loads into the WebView. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="calendar"
        android:enabled="true"
        android:icon="@drawable/shortcut_calendar"
        android:shortcutShortLabel="@string/shortcut_cal_short"
        android:shortcutLongLabel="@string/shortcut_cal_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="gift.dhamma.uposatha"
            android:targetClass="gift.dhamma.uposatha.MainActivity">
            <extra android:name="route" android:value="/uposatha-calendar?app=1&amp;tab=cal" />
        </intent>
    </shortcut>
</shortcuts>
