<?xml version="1.0" encoding="utf-8"?>
<!-- The Uposatha mark as a vector in its FINAL frame-0 state (docs: AN 3.70, the mirror is cleaned): the moon
     behind clouds. dg_splash_icon.xml animates it once. The moon is cut around each cloud by a wider stroke
     in the splash background colour; a cut lives in the same-named group as its cloud's "cut" twin, so the
     two travel together and no empty band is left on the moon. Cuts and clouds are separate paths so a cut
     never eats the cloud dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp" android:height="288dp" android:viewportWidth="288" android:viewportHeight="288">
    <group android:name="art" android:translateX="84.963" android:translateY="84.963" android:scaleX="2.01835" android:scaleY="2.01835">
        <group android:name="moon" android:pivotX="39" android:pivotY="25">
            <path android:fillColor="@color/dg_splash_moon"
                android:pathData="M39,25m-17,0a17,17 0 1,0 34,0a17,17 0 1,0 -34,0"/>
        </group>
        <group android:name="cutTop">
            <path android:name="cutTopPath" android:strokeColor="@color/dg_splash_bg" android:strokeWidth="13" android:strokeLineCap="round"
                android:pathData="M6,37H31"/>
        </group>
        <group android:name="cutBottom">
            <path android:name="cutBottomPath" android:strokeColor="@color/dg_splash_bg" android:strokeWidth="13" android:strokeLineCap="round"
                android:pathData="M15,47H43"/>
        </group>
        <group android:name="cloudTop">
            <path android:name="cloudTopPath" android:strokeColor="@color/dg_splash_cloud" android:strokeWidth="7" android:strokeLineCap="round"
                android:pathData="M6,37H31"/>
        </group>
        <group android:name="cloudBottom">
            <path android:name="cloudBottomPath" android:strokeColor="@color/dg_splash_cloud" android:strokeWidth="7" android:strokeLineCap="round"
                android:pathData="M15,47H43"/>
        </group>
        <group android:name="cloudDot">
            <path android:name="cloudDotPath" android:strokeColor="@color/dg_splash_cloud" android:strokeWidth="7" android:strokeLineCap="round"
                android:pathData="M50,47H53"/>
        </group>
    </group>
</vector>
