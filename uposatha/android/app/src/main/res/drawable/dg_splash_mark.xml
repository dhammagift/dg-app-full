<?xml version="1.0" encoding="utf-8"?>
<!-- The Uposatha mark as a vector in its FINAL state (docs/launch-screens: the moon rising from under a
     cloud); dg_splash_icon.xml animates it. The moon is cut by the cloud with wider strokes in the splash's
     own background colour, drawn over it — which is also why the moon looks to rise from UNDER the cloud. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp" android:height="288dp" android:viewportWidth="288" android:viewportHeight="288">
    <group android:name="art" android:translateX="84.963" android:translateY="84.963" android:scaleX="2.01835" android:scaleY="2.01835">
        <group android:name="rise">
            <path android:name="moon" android:fillColor="@color/dg_splash_moon"
                android:pathData="M39,25m-17,0a17,17 0 1,0 34,0a17,17 0 1,0 -34,0"/>
        </group>
        <path android:strokeColor="@color/dg_splash_bg" android:strokeWidth="13" android:strokeLineCap="round"
            android:pathData="M6,37H31M15,47H43"/>
        <path android:name="cloud1" android:strokeColor="@color/dg_splash_cloud" android:strokeWidth="7" android:strokeLineCap="round"
            android:pathData="M6,37H31"/>
        <path android:name="cloud2" android:strokeColor="@color/dg_splash_cloud" android:strokeWidth="7" android:strokeLineCap="round"
            android:pathData="M15,47H43"/>
        <path android:name="cloud3" android:strokeColor="@color/dg_splash_cloud" android:strokeWidth="7" android:strokeLineCap="round"
            android:pathData="M50,47H53"/>
    </group>
</vector>
