<?xml version="1.0" encoding="utf-8"?>
<!-- One pass, 890 ms: the whole mark stands still for 250 ms so it can be read,
     the clouds part (250-650 ms, cuts travel with them), the clean moon pulses once (650-780 up, 780-890 back). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/dg_splash_mark">
    <target android:name="cloudTop" android:animation="@animator/dg_splash_move_left"/>
    <target android:name="cutTop" android:animation="@animator/dg_splash_move_left"/>
    <target android:name="cloudBottom" android:animation="@animator/dg_splash_move_right"/>
    <target android:name="cutBottom" android:animation="@animator/dg_splash_move_right"/>
    <target android:name="cloudDot" android:animation="@animator/dg_splash_move_dot"/>
    <target android:name="cloudTopPath" android:animation="@animator/dg_splash_fade"/>
    <target android:name="cutTopPath" android:animation="@animator/dg_splash_fade"/>
    <target android:name="cloudBottomPath" android:animation="@animator/dg_splash_fade"/>
    <target android:name="cutBottomPath" android:animation="@animator/dg_splash_fade"/>
    <target android:name="cloudDotPath" android:animation="@animator/dg_splash_fade"/>
    <target android:name="moon" android:animation="@animator/dg_splash_pulse"/>
</animated-vector>
