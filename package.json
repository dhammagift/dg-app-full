{
  "name": "dg-app-full",
  "private": true,
  "description": "Dhamma.gift offline Android/iOS app. The UI is not maintained here — it is generated from a dg-node checkout at build time (see paths.js / DG_NODE_PATH); this repo holds only the app's own files: the fetch shim, the native bridge, the build scripts and the native platform projects.",
  "scripts": {
    "build": "node build-page.js && node build-assets.js",
    "build-assets": "node build-assets.js",
    "build-page": "node build-page.js",
    "build-toc-snapshot": "node build-toc-snapshot.js",
    "serve-dist": "node serve-dist.js",
    "serve-local": "node test/serve-local.js www dist 8097",
    "sync-android": "cap sync android",
    "test-e2e": "node test/e2e-browser.js",
    "test-parity": "node test/core-parity.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0"
  }
}
