 "status": 200,
 "body": {
  "sutta_id": "dn22",
  "category": "dhamma",
  "dir_path": "pli/ms/sutta/dn",
  "title": "Mahāsatipaṭṭhānasutta",
  "mr": 12,
  "segments": [
   {
    "segment": "dn22:0.1",
    "root_text": "Dīgha Nikāya 22",
    "variant": "",
    "html": "<header><h1>",
    "translations": {
     "ru_o": "Дигха Никая 22",
     "ru_sv": "ДН 22"
    }
   },
   {
    "segment": "dn22:1.1",
    "root_text": "Evaṁ me sutaṁ—",
    "variant": "",
    "html": "<p>",
    "translations": {
     "ru_o": "Так я слышал —",
     "ru_sv": "Вот что я слышал."
    }
   },
   {
    "segment": "dn22:1.2",
    "root_text": "ekaṁ samayaṁ bhagavā kurūsu viharati.",
    "variant": "kurūsu → kurusu",
    "html": "",
    "translations": {
     "ru_o": "однажды Благословенный жил среди куру.",
     "ru_sv": "Однажды Благословенный пребывал в стране Куру."
    }
   },
   {
    "segment": "dn22:1.3",
    "root_text": "Seyyathāpi kacchapo aṅgāni sake kapāle samodahati.",
    "variant": "kacchapo → kacchapa",
    "html": "",
    "translations": {
     "ru_o": "Подобно тому, как черепаха втягивает конечности в панцирь.",
     "ru_sv": "Словно чepeпaxa, прячущая лапы в свой панцирь."
    }
   },
   {
    "segment": "dn22:1.4",
    "root_text": "Mahākacchapānaṁ pana rūpaṁ evaṁ hoti.",
    "variant": "",
    "html": "",
    "translations": {
     "ru_o": "У больших черепах облик именно таков.",
     "ru_sv": "Облик больших черепах таков."
    }
   },
   {
    "segment": "dn22:1.5",
    "root_text": "Idaṁ vuccati, bhikkhave, dukkhaṁ ariyasaccaṁ.",
    "variant": "",
    "html": "</p>",
    "translations": {
     "ru_o": "Это, монахи, называется благородной истиной о страдании.",
     "ru_sv": "Это зовётся, монахи, благородной истиной о страдании."
    }
   }
  ],
  "columns": [
   "ru",
   "en"
  ],
  "lang": "ru"
 }
}
