<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: the hosts whose https links open this app instead of Safari, once
	     https://dhamma.gift/.well-known/apple-app-site-association lists this app's team id (dg-node's
	     route, configs/apple-app-site-association). The same six hosts Android's autoVerify filter
	     claims in AndroidManifest.xml, so a link behaves the same on either platform.

	     The capability has to be enabled on the App ID in the developer account before a SIGNED build
	     can use it: the entitlement alone is not enough, and a simulator build neither needs nor
	     checks it. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:dhamma.gift</string>
		<string>applinks:www.dhamma.gift</string>
		<string>applinks:f.dhamma.gift</string>
		<string>applinks:www.f.dhamma.gift</string>
		<string>applinks:find.dhamma.gift</string>
		<string>applinks:www.find.dhamma.gift</string>
	</array>
</dict>
</plist>
