<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Web Share Target equivalent (dg-twa's web manifest: share_target action "/",
                 param "q") — lets other apps' "Share" menu send plain text here, which
                 MainActivity.handleIntent turns into a search (?q=...) in the SPA. A Capacitor
                 WebView doesn't get this from the web manifest automatically like a TWA does. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Text-selection menu: select a passage in any app and "Dhamma.gift" sits right in
                 the selection toolbar (or its ⋮ overflow) next to Copy/Translate, so the reader
                 taps it directly instead of going through Share → Dhamma.gift — one chooser less.
                 The label Android prints there is this activity's own android:label above, which
                 is the app name, so nothing extra to declare. MainActivity.handleIntent treats
                 the selected text exactly like a shared one (same ?q= path).

                 android:priority="1000": the platform appends these items in the order
                 PackageManager.queryIntentActivities hands them over, and for activities that
                 order is RESOLVE_PRIORITY_SORTER — priority first, then system-before-user, and
                 only then the package name alphabetically (Editor.ProcessTextIntentActions
                 Handler.onInitializeMenu). At the default 0 we sorted after every com.* app, at
                 the bottom of a menu that scrolls; 1000 is the maximum, so we come first.

                 text/* rather than text/plain: the platform's own selection intent is text/plain
                 and matches either, but rich-text editors send text/html — and those are exactly
                 the apps (Gmail's composer) where the item never showed up. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Deep links: a dhamma.gift URL tapped anywhere on the device (browser, chat app,
                 email) opens straight into the app instead of the browser, at the same path —
                 MainActivity.handleIntent turns the URL's path+query into the SPA's own
                 _nativeRoute (same mechanism the App Shortcuts above already use).

                 android:autoVerify="true": Android confirms this app controls these hosts by
                 fetching https://dhamma.gift/.well-known/assetlinks.json (dg-fastify.js route,
                 see its own comment) and checking this APK's signing certificate against the
                 fingerprint listed there — only then does a tap skip the "Open with: Chrome /
                 Dhamma.gift" chooser entirely, including for links tapped INSIDE Chrome itself
                 (which a non-verified filter never intercepts at all, chooser or not). That
                 verification only ever passes for a build signed with the release key
                 (android.keystore, gitignored — see android.keystore.readme) whose fingerprint
                 is the one actually published; a debug-signed build still registers the intent
                 -filter (chooser dialog from outside Chrome/Telegram's in-app browser) but can
                 never pass verification. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="dhamma.gift" />
                <data android:scheme="https" android:host="www.dhamma.gift" />
                <data android:scheme="https" android:host="f.dhamma.gift" />
                <data android:scheme="https" android:host="www.f.dhamma.gift" />
                <data android:scheme="https" android:host="find.dhamma.gift" />
                <data android:scheme="https" android:host="www.find.dhamma.gift" />
            </intent-filter>

            <!-- Google sign-in handoff: dhamma.gift/login/app-google.html, opened in the system
                 browser, returns through an intent:// URL that names this app's package (see
                 MainActivity.handleIntent). A custom scheme, so no autoVerify. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dhammagift" android:host="auth" />
            </intent-filter>

            <!-- Every other dhammagift:// URL is one of the app's own deep links (docs/DEEP_LINKS.md):
                 dhammagift://mn1 opens a text, dhammagift://kacchapa searches, dhammagift://route/toc
                 opens an SPA route. A separate filter rather than widening the one above, so the
                 login handoff keeps exactly the filter it has always had. No host attribute on
                 purpose: the host IS the route here, and MainActivity hands the whole URL to the
                 page, which maps it in src/deep-link.js — the same file iOS uses, so one scheme
                 cannot come to mean two different things on two platforms.
                 Like the auth filter, no autoVerify: a custom scheme cannot be verified against a
                 server, which is why dhamma.gift itself is claimed by the https filter above. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dhammagift" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Holds the foreground slot for the offline-library download (see DgDownloadService):
             without it Android is free to freeze the WebView process the moment the reader
             switches away, and the transfer is exactly what the notification is reporting on. -->
        <service
            android:name=".DgDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- "Продолжить чтение" in the Quick Settings shade (DgResumeTileService): opens the text
             the reader last had open — the top dynamic shortcut the page already pushes via
             DgShortcutsPlugin — or the app itself when there is none. The Android counterpart of
             the iOS Control Center control (branch siri). exported="true" is required: the
             system's Quick Settings process binds this service, and without the flag it could
             never be added to the shade. BIND_QUICK_SETTINGS_TILE is a signature permission held
             by the platform, so only the system can bind it — no other app can reach in.
             No permission attribute on purpose: the permission is one the CALLER holds; declaring
             android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" is the documented
             form and is what actually restricts binding to the system. -->
        <service
            android:name=".DgResumeTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_resume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The offline-library download keeps running while the app is backgrounded: the
         ongoing progress notification holds a foreground service slot (DgDownloadService),
         which is what stops Android treating the WebView process as idle mid-transfer. -->
    <!-- The download must survive the screen going off: the foreground slot keeps the process,
         these keep the CPU and the radio (see DgDownloadService.acquireLocks). WAKE_LOCK and the
         two Wi-Fi permissions are normal permissions — nothing is asked of the reader. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Read by the Network plugin (hasNetworkConsent in app.js) to tell Wi-Fi from cellular
         before asking about the library download. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11+ package visibility: without this the TextToSpeech engine (DgTtsPlugin) is not found. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
