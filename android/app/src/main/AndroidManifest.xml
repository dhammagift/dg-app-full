<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Web Share Target equivalent (dg-twa's web manifest: share_target action "/",
                 param "q") — lets other apps' "Share" menu send plain text here, which
                 MainActivity.handleIntent turns into a search (?q=...) in the SPA. A Capacitor
                 WebView doesn't get this from the web manifest automatically like a TWA does. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Deep links: a dhamma.gift URL tapped anywhere on the device (browser, chat app,
                 email) opens straight into the app instead of the browser, at the same path —
                 MainActivity.handleIntent turns the URL's path+query into the SPA's own
                 _nativeRoute (same mechanism the App Shortcuts above already use).

                 No android:autoVerify="true" yet: verified App Links need a stable release
                 signing key and a matching assetlinks.json published at
                 https://dhamma.gift/.well-known/ — this app currently only ships an
                 auto-signed debug build. Without it, Android still registers these hosts, it
                 just shows a disambiguation dialog ("Open with: Chrome / Dhamma.gift") instead
                 of skipping straight to the app. Add autoVerify once a release key exists. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="dhamma.gift" />
                <data android:scheme="https" android:host="www.dhamma.gift" />
                <data android:scheme="https" android:host="f.dhamma.gift" />
                <data android:scheme="https" android:host="www.f.dhamma.gift" />
                <data android:scheme="https" android:host="find.dhamma.gift" />
                <data android:scheme="https" android:host="www.find.dhamma.gift" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read by the Network plugin (hasNetworkConsent in app.js) to tell Wi-Fi from cellular
         before asking about the library download. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
