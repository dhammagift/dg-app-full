<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Web Share Target equivalent (dg-twa's web manifest: share_target action "/",
                 param "q") — lets other apps' "Share" menu send plain text here, which
                 MainActivity.handleIntent turns into a search (?q=...) in the SPA. A Capacitor
                 WebView doesn't get this from the web manifest automatically like a TWA does. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Without this, DownloadManager cannot read the device's connectivity state and treats the
         network as unavailable forever — every download sits at PAUSED_WAITING_FOR_NETWORK no
         matter how good the connection actually is. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+. The library download runs through DownloadManager so it survives the app
         being backgrounded; this is what lets the system draw its progress in the shade. Without
         it the download still runs, just invisibly, so it is requested before the first one
         rather than required. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
