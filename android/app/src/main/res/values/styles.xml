<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. DayNight, not fixed Light: the app has a dark mode (the site's own
         theme setting lives in localStorage and is applied by the page), so the native chrome —
         the window behind the WebView before the first paint, dialogs, the system bars — should
         follow the OS instead of forcing everything light. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Issue #15: the strip behind the status bar is the site's dark navbar band, in both
             themes (see colors.xml). Light icons on it, never the system's light-mode default. -->
        <item name="android:windowBackground">@color/dg_navbar</item>
        <item name="android:statusBarColor">@color/dg_navbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Issue #15: the strip behind the status bar is the site's dark navbar band, in both
             themes (see colors.xml). Light icons on it, never the system's light-mode default. -->
        <item name="android:windowBackground">@color/dg_navbar</item>
        <item name="android:statusBarColor">@color/dg_navbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The launch screen. It used to be @drawable/splash — a PNG rendered on WHITE for every
         density — so a dark-mode device got a white flash before the (dark) page appeared, which is
         what the owner reported. Now it is the launcher icon's own background colour with the
         icon's foreground centred: the same mark the reader just tapped, in both themes, no white.
         postSplashScreenTheme is what hands over to the real theme; without it the app would keep
         the splash theme and the WebView would never appear. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dg_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/dg_splash_blank</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/dg_splash_bg</item>
        <!-- The splash window is #2E3E50 — dark — so its status bar needs the same light icons as
             the real theme; without this the launch screen inherited the light-mode default (dark
             icons) and the clock was invisible from the first frame. -->
        <item name="android:windowLightStatusBar">@bool/dg_splash_light_bar</item>
    </style>
</resources>