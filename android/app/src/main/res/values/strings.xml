<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- app_name and title_activity_main are NOT here on purpose: build.gradle generates them with
         resValue, because the label depends on the applicationId (gift.dhamma.twa is "Dhamma.gift",
         the test package gift.dhamma.mobile is "DGift"). A copy here would collide with the
         generated one. -->
    <string name="package_name">gift.dhamma.mobile</string>
    <string name="custom_url_scheme">gift.dhamma.mobile</string>

    <!-- App Shortcuts labels (res/xml/shortcuts.xml). Only Favorites & History is a static
         shortcut now — the launcher's four slots go to it plus three "recently read" (owner,
         2026-09-24: "должны быть 3 пункта под историю"). The other three labels stay: they are the
         same four dg-twa's twaManifest.shortcuts and the site's manifest declare
         (docs/PWA_SHORTCUTS.md), and the app still has those routes. Labels are not translated —
         the site manifest does not translate them either, and the app name is Latin, so a phone in
         Russian shows the same words. -->
    <string name="shortcut_toc_short">Table of Contents</string>
    <string name="shortcut_toc_long">Table of Contents</string>
    <string name="shortcut_dict_short">Dictionary</string>
    <string name="shortcut_dict_long">Dictionary</string>
    <string name="shortcut_fav_short">Favorites &amp; History</string>
    <string name="shortcut_fav_long">Favorites &amp; History</string>
    <string name="shortcut_memo_short">Memo</string>
    <string name="shortcut_memo_long">Memo</string>

    <!-- Shown by the system's search settings next to the app's name (res/xml/searchable.xml,
         android:searchSettingsDescription). -->
    <string name="search_settings_description">Search the Pali canon and its translations</string>
</resources>
