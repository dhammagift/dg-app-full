<?xml version="1.0" encoding="utf-8"?>
<!-- Static App Shortcuts (long-press the launcher icon).

     Icons come from dg-twa (owner: "шорткаты и иконки неактуальные возьми из dg-twa там последняя
     версия") — drawable-*/shortcut_N.png, mirrored here.

     Only TWO static shortcuts: Dictionary and Memo. Contents (TOC) and Favorites & history are
     pushed as DYNAMIC shortcuts with the top ranks by the page (native-bridge.js collectRecent),
     because Android shows dynamic shortcuts ABOVE static ones and a launcher shows four — so the
     owner's intended order for the app ("toc, fav+history, dyn, dyn") is only reachable that way.
     These two appear on launchers that show more than four, and before the page has run once.

     Two of the four cannot run inside this app and are routed to the real browser by
     native-bridge.js (see EXTERNAL_ROUTES there):
       - Dictionary (/dict): a server-rendered page of dict.dhamma.gift, not part of the SPA;
       - Memo (/memo): deliberately not bundled (owner: the APK should not carry occasionally-read
         sections — see native-bridge.js).
     TOC (/toc) and Favorites (/4as) are SPA routes and open in place.

     Each shortcut launches MainActivity with a "route" extra; MainActivity turns it into
     https://localhost/?_nativeRoute=..., and the page rewrites the visible URL before its own
     bootstrap reads it. Dynamic "recently read" shortcuts (DgShortcutsPlugin) fill whatever slots
     the launcher has left. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="dictionary"
        android:enabled="true"
        android:icon="@drawable/shortcut_1"
        android:shortcutShortLabel="@string/shortcut_dict_short"
        android:shortcutLongLabel="@string/shortcut_dict_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="gift.dhamma.mobile"
            android:targetClass="gift.dhamma.mobile.MainActivity">
            <extra android:name="route" android:value="/dict" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="memo"
        android:enabled="true"
        android:icon="@drawable/shortcut_3"
        android:shortcutShortLabel="@string/shortcut_memo_short"
        android:shortcutLongLabel="@string/shortcut_memo_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="gift.dhamma.mobile"
            android:targetClass="gift.dhamma.mobile.MainActivity">
            <extra android:name="route" android:value="/memo" />
        </intent>
    </shortcut>
</shortcuts>
