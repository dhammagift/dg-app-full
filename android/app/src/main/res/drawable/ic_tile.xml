<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick Settings tile icon: the wheel, white on transparent, 24dp. Monochrome on purpose —
     the system tints tile icons, so a coloured or gradient mark turns into a flat blob. Kept as a
     hand-written vector rather than the launcher foreground, which is a 108dp adaptive-icon layer
     with gradients and would read as a cropped fragment in the shade. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- rim: outer circle minus inner circle (evenOdd) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2a10,10 0 1,0 0.001,0zM12,4.2a7.8,7.8 0 1,1 -0.001,0z" />
    <!-- hub -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,10.4a1.6,1.6 0 1,0 0.001,0zM12,11.4a0.6,0.6 0 1,1 -0.001,0z" />
    <!-- spokes -->
    <path
        android:pathData="M12,4.4L12,10.4M12,13.6L12,19.6M4.4,12L10.4,12M13.6,12L19.6,12M6.6,6.6L10.9,10.9M13.1,13.1L17.4,17.4M17.4,6.6L13.1,10.9M10.9,13.1L6.6,17.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.3" />
</vector>
