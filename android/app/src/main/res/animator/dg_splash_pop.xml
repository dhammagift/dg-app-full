<?xml version="1.0" encoding="utf-8"?>
<!-- The mark settles: scale .96 -> 1 and up 8 px (58 units of the 1376-wide drawing), on the same clock. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:duration="900" android:propertyName="scaleX" android:valueType="floatType"
        android:valueFrom="0.96" android:valueTo="1" android:interpolator="@android:interpolator/decelerate_cubic"/>
    <objectAnimator android:duration="900" android:propertyName="scaleY" android:valueType="floatType"
        android:valueFrom="0.96" android:valueTo="1" android:interpolator="@android:interpolator/decelerate_cubic"/>
    <objectAnimator android:duration="900" android:propertyName="translateY" android:valueType="floatType"
        android:valueFrom="58" android:valueTo="0" android:interpolator="@android:interpolator/decelerate_cubic"/>
</set>
